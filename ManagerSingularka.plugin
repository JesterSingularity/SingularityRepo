# ==AyugramPlugin==
# @name         ManagerSingularka
# @version      1.0.0
# @description  Менеджер быстрых шаблонов с auto-update
# @author       JesterSingularity
# @command      addtpl
# @command      deltpl
# @command      listtpl
# @command      edittpl
# @command      checkupdate
# @command-desc .addtpl .cmd [text] - добавить шаблон
# @icon         exteraPlugins/1
# @min_version  11.12.0
# ==/AyugramPlugin==

# =========================================================
#                       ИМПОРТЫ
# =========================================================

import json
import os
import threading
import time
import urllib.request

from typing import Any

from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import send_message

# =========================================================
#                   META ИНФОРМАЦИЯ
# =========================================================

__id__ = "ManagerSingularka"

__name__ = "ManagerSingularka"

__description__ = "Менеджер быстрых шаблонов"

__author__ = "JesterSingularity"

__version__ = "1.0.0"

__icon__ = "exteraPlugins/1"

__min_version__ = "11.12.0"

# =========================================================
#                     CONFIG
# =========================================================

CURRENT_VERSION = "1.0.0"

VERSION_URL = (
    "https://raw.githubusercontent.com/"
    "JesterSingularity/"
    "SingularityRepo/"
    "main/"
    "version.json"
)

PLUGIN_DOWNLOAD_URL = (
    "https://raw.githubusercontent.com/"
    "JesterSingularity/"
    "SingularityRepo/"
    "main/"
    "ManagerSingularka.plugin"
)

PLUGIN_FILE_NAME = "ManagerSingularka.plugin"

UPDATE_CHECK_INTERVAL = 600

DATA_FILE = "ManagerSingularka_templates.json"

# =========================================================
#                  ГЛАВНЫЙ КЛАСС
# =========================================================


class ManagerSingularkaPlugin(BasePlugin):

    # =====================================================
    #                ЗАГРУЗКА ПЛАГИНА
    # =====================================================

    def on_plugin_load(self):

        # Регистрируем hook
        self.add_on_send_message_hook()

        # Загружаем шаблоны
        self.templates = self.load_templates()

        # Запускаем auto updater
        threading.Thread(
            target=self.auto_update_loop,
            daemon=True
        ).start()

    # =====================================================
    #                 ЗАГРУЗКА JSON
    # =====================================================

    def load_templates(self):

        if not os.path.exists(DATA_FILE):
            return {}

        try:

            with open(
                DATA_FILE,
                "r",
                encoding="utf-8"
            ) as f:

                return json.load(f)

        except Exception:
            return {}

    # =====================================================
    #                 СОХРАНЕНИЕ JSON
    # =====================================================

    def save_templates(self):

        try:

            with open(
                DATA_FILE,
                "w",
                encoding="utf-8"
            ) as f:

                json.dump(
                    self.templates,
                    f,
                    ensure_ascii=False,
                    indent=4
                )

        except Exception:
            pass

    # =====================================================
    #               AUTO UPDATE LOOP
    # =====================================================

    def auto_update_loop(self):

        while True:

            try:
                self.check_for_updates()

            except Exception:
                pass

            time.sleep(UPDATE_CHECK_INTERVAL)

    # =====================================================
    #               ПРОВЕРКА ОБНОВЛЕНИЙ
    # =====================================================

    def check_for_updates(self):

        try:

            with urllib.request.urlopen(
                VERSION_URL
            ) as response:

                data = response.read().decode("utf-8")

            version_data = json.loads(data)

            latest_version = version_data.get("version")

            if latest_version != CURRENT_VERSION:

                self.download_update(latest_version)

        except Exception:
            pass

    # =====================================================
    #                 СКАЧИВАНИЕ UPDATE
    # =====================================================

    def download_update(self, latest_version):

        try:

            with urllib.request.urlopen(
                PLUGIN_DOWNLOAD_URL
            ) as response:

                plugin_code = response.read().decode("utf-8")

            with open(
                PLUGIN_FILE_NAME,
                "w",
                encoding="utf-8"
            ) as f:

                f.write(plugin_code)

            send_message({
                "peer": "me",
                "message":
                    "🔥 ManagerSingularka обновлён!\n\n"
                    f"Новая версия: {latest_version}\n\n"
                    "♻️ Перезапусти AyuGram"
            })

        except Exception:
            pass

    # =====================================================
    #               РУЧНАЯ ПРОВЕРКА UPDATE
    # =====================================================

    def manual_check_update(self, peer):

        try:

            with urllib.request.urlopen(
                VERSION_URL
            ) as response:

                data = response.read().decode("utf-8")

            version_data = json.loads(data)

            latest_version = version_data.get("version")

            if latest_version == CURRENT_VERSION:

                send_message({
                    "peer": peer,
                    "message":
                        "✅ У тебя последняя версия"
                })

                return

            self.download_update(latest_version)

        except Exception:

            send_message({
                "peer": peer,
                "message":
                    "❌ Ошибка проверки обновлений"
            })

    # =====================================================
    #                ОСНОВНОЙ HOOK
    # =====================================================

    def on_send_message_hook(
        self,
        account: int,
        params: Any
    ) -> HookStrategy:

        msg = params.message if isinstance(
            params.message,
            str
        ) else ""

        if not msg:
            return HookResult()

        text = msg.strip()

        # =================================================
        #                .addtpl
        # =================================================

        if text.startswith(".addtpl "):

            raw = text[len(".addtpl "):].strip()

            if "[" not in raw or "]" not in raw:

                send_message({
                    "peer": params.peer,
                    "message":
                        "❌ Формат:\n"
                        ".addtpl .cmd [текст]"
                })

                return HookResult(
                    strategy=HookStrategy.CANCEL
                )

            try:

                cmd = raw.split("[")[0].strip()

                template_text = raw[
                    raw.index("[") + 1:
                    raw.rindex("]")
                ]

                self.templates[cmd] = template_text

                self.save_templates()

                send_message({
                    "peer": params.peer,
                    "message":
                        f"✅ Шаблон {cmd} сохранён"
                })

            except Exception:

                send_message({
                    "peer": params.peer,
                    "message":
                        "❌ Ошибка сохранения"
                })

            return HookResult(
                strategy=HookStrategy.CANCEL
            )

        # =================================================
        #                .deltpl
        # =================================================

        if text.startswith(".deltpl "):

            cmd = text[len(".deltpl "):].strip()

            if cmd not in self.templates:

                send_message({
                    "peer": params.peer,
                    "message":
                        "❌ Шаблон не найден"
                })

                return HookResult(
                    strategy=HookStrategy.CANCEL
                )

            del self.templates[cmd]

            self.save_templates()

            send_message({
                "peer": params.peer,
                "message":
                    f"🗑 Шаблон {cmd} удалён"
            })

            return HookResult(
                strategy=HookStrategy.CANCEL
            )

        # =================================================
        #                .listtpl
        # =================================================

        if text == ".listtpl":

            if not self.templates:

                send_message({
                    "peer": params.peer,
                    "message":
                        "📭 Шаблонов нет"
                })

                return HookResult(
                    strategy=HookStrategy.CANCEL
                )

            result = "📚 Шаблоны:\n\n"

            for cmd in self.templates:
                result += f"• {cmd}\n"

            send_message({
                "peer": params.peer,
                "message": result
            })

            return HookResult(
                strategy=HookStrategy.CANCEL
            )

        # =================================================
        #                .edittpl
        # =================================================

        if text.startswith(".edittpl "):

            raw = text[len(".edittpl "):].strip()

            if "[" not in raw or "]" not in raw:

                send_message({
                    "peer": params.peer,
                    "message":
                        "❌ Формат:\n"
                        ".edittpl .cmd [текст]"
                })

                return HookResult(
                    strategy=HookStrategy.CANCEL
                )

            try:

                cmd = raw.split("[")[0].strip()

                new_text = raw[
                    raw.index("[") + 1:
                    raw.rindex("]")
                ]

                if cmd not in self.templates:

                    send_message({
                        "peer": params.peer,
                        "message":
                            "❌ Шаблон не найден"
                    })

                    return HookResult(
                        strategy=HookStrategy.CANCEL
                    )

                self.templates[cmd] = new_text

                self.save_templates()

                send_message({
                    "peer": params.peer,
                    "message":
                        f"✏️ Шаблон {cmd} обновлён"
                })

            except Exception:

                send_message({
                    "peer": params.peer,
                    "message":
                        "❌ Ошибка изменения"
                })

            return HookResult(
                strategy=HookStrategy.CANCEL
            )

        # =================================================
        #              .checkupdate
        # =================================================

        if text == ".checkupdate":

            self.manual_check_update(params.peer)

            return HookResult(
                strategy=HookStrategy.CANCEL
            )

        # =================================================
        #                АВТОЗАМЕНА
        # =================================================

        if text in self.templates:

            template_text = self.templates[text]

            send_message({
                "peer": params.peer,
                "message": template_text
            })

            return HookResult(
                strategy=HookStrategy.CANCEL
            )

        # =================================================
        #                 НИЧЕГО
        # =================================================

        return HookResult()
