# =========================================================
#                        IMPORTS
# =========================================================

import json
import os
import random
import threading
import time
import urllib.request

from datetime import datetime
from typing import Any

from base_plugin import (
    BasePlugin,
    HookResult,
    HookStrategy
)

from client_utils import send_message

# =========================================================
#                         META
# =========================================================

__id__ = "ManagerSingularka"

__name__ = "ManagerSingularka"

__description__ = "Advanced template engine"

__author__ = "JesterSingularity"

__version__ = "2.0.0"

__icon__ = "exteraPlugins/1"

__min_version__ = "11.12.0"

# =========================================================
#                        STORAGE
# =========================================================

DATA_FILE = "ManagerSingularka_templates.json"

# =========================================================
#                      MAIN CLASS
# =========================================================


class ManagerSingularkaPlugin(BasePlugin):

    # =====================================================
    #                    AUTO UPDATE
    # =====================================================

    VERSION_URL = (
        "https://raw.githubusercontent.com/"
        "JesterSingularity/"
        "SingularityRepo/"
        "main/"
        "version.json"
    )

    PLUGIN_URL = (
        "https://raw.githubusercontent.com/"
        "JesterSingularity/"
        "SingularityRepo/"
        "main/"
        "ManagerSingularka.plugin"
    )

    CURRENT_VERSION = "2.0.0"

    PLUGIN_FILE = "ManagerSingularka.plugin"

    # =====================================================
    #                    PLUGIN LOAD
    # =====================================================

    def on_plugin_load(self):

        self.add_on_send_message_hook()

        self.templates = self.load_templates()

        # updater loop
        threading.Thread(
            target=self.auto_update_loop,
            daemon=True
        ).start()

    # =====================================================
    #                     JSON LOAD
    # =====================================================

    def load_templates(self):

        if not os.path.exists(DATA_FILE):
            return {}

        try:

            with open(
                DATA_FILE,
                "r",
                encoding="utf-8"
            ) as f:

                return json.load(f)

        except Exception:

            return {}

    # =====================================================
    #                     JSON SAVE
    # =====================================================

    def save_templates(self):

        try:

            with open(
                DATA_FILE,
                "w",
                encoding="utf-8"
            ) as f:

                json.dump(
                    self.templates,
                    f,
                    ensure_ascii=False,
                    indent=4
                )

        except Exception:
            pass

    # =====================================================
    #                   UPDATE LOOP
    # =====================================================

    def auto_update_loop(self):

        while True:

            try:

                self.check_updates()

            except Exception:
                pass

            time.sleep(600)

    # =====================================================
    #                  CHECK UPDATES
    # =====================================================

    def check_updates(self):

        with urllib.request.urlopen(
            self.VERSION_URL
        ) as response:

            data = response.read().decode(
                "utf-8"
            )

        version_data = json.loads(data)

        latest = version_data.get(
            "version"
        )

        if latest != self.CURRENT_VERSION:

            self.download_update(
                latest
            )

    # =====================================================
    #                 DOWNLOAD UPDATE
    # =====================================================

    def download_update(
        self,
        latest_version
    ):

        with urllib.request.urlopen(
            self.PLUGIN_URL
        ) as response:

            plugin_code = response.read().decode(
                "utf-8"
            )

        with open(
            self.PLUGIN_FILE,
            "w",
            encoding="utf-8"
        ) as f:

            f.write(plugin_code)

        send_message({
            "peer": "me",
            "message":
                "🔥 ManagerSingularka updated!\n"
                f"Version: {latest_version}\n\n"
                "♻️ Restart AyuGram"
        })

    # =====================================================
    #                  CONDITION ENGINE
    # =====================================================

    def check_condition(
        self,
        condition
    ):

        # =============================================
        # NIGHT
        # =============================================

        if condition == "night":

            hour = datetime.now().hour

            return (
                hour >= 22
                or
                hour <= 6
            )

        # =============================================
        # DAY
        # =============================================

        elif condition == "day":

            hour = datetime.now().hour

            return (
                hour >= 7
                and
                hour <= 21
            )

        # =============================================
        # ALWAYS
        # =============================================

        elif condition == "always":

            return True

        return False

    # =====================================================
    #                 TEMPLATE EXECUTOR
    # =====================================================

    def execute_template(
        self,
        peer,
        template
    ):

        # =============================================
        # TEMPLATE REFERENCE
        # =============================================

        if isinstance(template, str):

            # template reference
            if template in self.templates:

                template = self.templates[
                    template
                ]

            # plain text
            else:

                send_message({
                    "peer": peer,
                    "message": template
                })

                return

        # =============================================
        # TEMPLATE TYPE
        # =============================================

        template_type = template.get(
            "type"
        )

        # =============================================
        # TEXT
        # =============================================

        if template_type == "text":

            send_message({
                "peer": peer,
                "message": template["text"]
            })

        # =============================================
        # RANDOM
        # =============================================

        elif template_type == "random":

            variants = template.get(
                "variants",
                []
            )

            if not variants:
                return

            selected = random.choice(
                variants
            )

            self.execute_template(
                peer,
                selected
            )

        # =============================================
        # REPEAT
        # =============================================

        elif template_type == "repeat":

            count = template.get(
                "count",
                1
            )

            interval = template.get(
                "interval",
                0
            )

            action = template.get(
                "action"
            )

            for i in range(count):

                self.execute_template(
                    peer,
                    action
                )

                if interval > 0:

                    time.sleep(
                        interval
                    )

        # =============================================
        # IF
        # =============================================

        elif template_type == "if":

            condition = template.get(
                "condition"
            )

            action = template.get(
                "action"
            )

            if self.check_condition(
                condition
            ):

                self.execute_template(
                    peer,
                    action
                )

    # =====================================================
    #                    COMMAND ROUTER
    # =====================================================

    def handle_command(
        self,
        peer,
        text
    ):

        # =================================================
        # .ADDTXT
        # =================================================

        if text.startswith(".addtxt "):

            raw = text[
                len(".addtxt "):
            ].strip()

            if "[" not in raw or "]" not in raw:

                send_message({
                    "peer": peer,
                    "message":
                        "❌ Формат:\n"
                        ".addtxt .cmd [text]"
                })

                return True

            cmd = raw.split("[")[0].strip()

            template_text = raw[
                raw.index("[") + 1:
                raw.rindex("]")
            ]

            self.templates[cmd] = {
                "type": "text",
                "text": template_text
            }

            self.save_templates()

            send_message({
                "peer": peer,
                "message":
                    f"✅ TEXT шаблон {cmd} сохранён"
            })

            return True

        # =================================================
        # .ADDRANDOM
        # =================================================

        elif text.startswith(".addrandom "):

            raw = text[
                len(".addrandom "):
            ].strip()

            if "[" not in raw or "]" not in raw:

                send_message({
                    "peer": peer,
                    "message":
                        "❌ Формат:\n"
                        ".addrandom .cmd [a|b|c]"
                })

                return True

            cmd = raw.split("[")[0].strip()

            variants_raw = raw[
                raw.index("[") + 1:
                raw.rindex("]")
            ]

            variants = [

                v.strip()

                for v in variants_raw.split("|")

                if v.strip()
            ]

            self.templates[cmd] = {
                "type": "random",
                "variants": variants
            }

            self.save_templates()

            send_message({
                "peer": peer,
                "message":
                    f"🎲 RANDOM шаблон {cmd} сохранён"
            })

            return True

        # =================================================
        # .ADDREP
        # =================================================

        elif text.startswith(".addrep "):

            raw = text[
                len(".addrep "):
            ].strip()

            parts = raw.split(" ", 3)

            if len(parts) < 4:

                send_message({
                    "peer": peer,
                    "message":
                        "❌ Формат:\n"
                        ".addrep .cmd count interval action"
                })

                return True

            try:

                cmd = parts[0]

                count = int(parts[1])

                interval = int(parts[2])

                action = parts[3]

                self.templates[cmd] = {
                    "type": "repeat",
                    "count": count,
                    "interval": interval,
                    "action": action
                }

                self.save_templates()

                send_message({
                    "peer": peer,
                    "message":
                        f"🔁 REPEAT шаблон {cmd} сохранён"
                })

            except Exception:

                send_message({
                    "peer": peer,
                    "message":
                        "❌ Ошибка repeat"
                })

            return True

        # =================================================
        # .ADDIF
        # =================================================

        elif text.startswith(".addif "):

            raw = text[
                len(".addif "):
            ].strip()

            parts = raw.split(" ", 2)

            if len(parts) < 3:

                send_message({
                    "peer": peer,
                    "message":
                        "❌ Формат:\n"
                        ".addif .cmd condition action"
                })

                return True

            cmd = parts[0]

            condition = parts[1]

            action = parts[2]

            self.templates[cmd] = {
                "type": "if",
                "condition": condition,
                "action": action
            }

            self.save_templates()

            send_message({
                "peer": peer,
                "message":
                    f"🧠 IF шаблон {cmd} сохранён"
            })

            return True

        # =================================================
        # .LISTTPL
        # =================================================

        elif text == ".listtpl":

            if not self.templates:

                send_message({
                    "peer": peer,
                    "message":
                        "📭 Шаблонов нет"
                })

                return True

            result = (
                "📚 Шаблоны:\n\n"
            )

            for cmd, data in self.templates.items():

                result += (
                    f"{cmd} "
                    f"({data.get('type')})\n"
                )

            send_message({
                "peer": peer,
                "message": result
            })

            return True

        # =================================================
        # .DELTPL
        # =================================================

        elif text.startswith(".deltpl "):

            cmd = text[
                len(".deltpl "):
            ].strip()

            if cmd not in self.templates:

                send_message({
                    "peer": peer,
                    "message":
                        "❌ Шаблон не найден"
                })

                return True

            del self.templates[cmd]

            self.save_templates()

            send_message({
                "peer": peer,
                "message":
                    f"🗑 Шаблон {cmd} удалён"
            })

            return True

        return False

    # =====================================================
    #                      MAIN HOOK
    # =====================================================

    def on_send_message_hook(
        self,
        account: int,
        params: Any
    ) -> HookStrategy:

        msg = params.message if isinstance(
            params.message,
            str
        ) else ""

        if not msg:
            return HookResult()

        text = msg.strip()

        # =============================================
        # COMMANDS
        # =============================================

        handled = self.handle_command(
            params.peer,
            text
        )

        if handled:

            return HookResult(
                strategy=HookStrategy.CANCEL
            )

        # =============================================
        # TEMPLATE EXECUTION
        # =============================================

        if text in self.templates:

            template = self.templates[
                text
            ]

            threading.Thread(
                target=self.execute_template,
                args=(
                    params.peer,
                    template
                ),
                daemon=True
            ).start()

            return HookResult(
                strategy=HookStrategy.CANCEL
            )

        # =============================================
        # NOTHING
        # =============================================

        return HookResult()
